# Copy to /opt/acp/<env>/.env on the server (chmod 600). Never commit real values.
APP_NAME="AI Collab Pipeline"
APP_ENV=production
APP_ENV_LABEL=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=acp
DB_USERNAME=acp
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Reverse proxy network (acp-edge) CIDR — only this proxy is trusted for X-Forwarded-*.
TRUSTED_PROXIES=172.30.0.0/16
# true = Discord alert per probe-path IP block (default: daily .env summary only)
SECURITY_NOTIFY_PROBE_BLOCKS=false

OPS_NOTIFIER=discord
OPS_DISCORD_WEBHOOK=
OPS_SLACK_WEBHOOK=

GITHUB_REPO=owner/ai-collab-pipeline
GITHUB_INCIDENT_TOKEN=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
